generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String           @map("password_hash")
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  memberships     FamilyMember[]
  refreshTokens   RefreshToken[]
  records         Record[]
  mealSuggestions MealSuggestion[]
  sentInvites     FamilyInvite[]   @relation("InviteCreatedBy")
  usedInvites     FamilyInvite[]   @relation("InviteUsedBy")

  @@map("users")
}

model Family {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  /// AI 機能（食事の提案・週次レポート）で記録を Anthropic（米国）に送ることへの同意。
  /// 管理者が同意した家族だけが対象になる。取り消すと null
  aiConsentAt      DateTime?      @map("ai_consent_at")
  aiConsentVersion Int?           @map("ai_consent_version")
  aiConsentById    String?        @map("ai_consent_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  members          FamilyMember[]
  children         Child[]
  invites          FamilyInvite[]

  @@map("families")
}

enum FamilyRole {
  OWNER
  MEMBER
}

model FamilyMember {
  familyId  String     @map("family_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      FamilyRole @default(MEMBER)
  createdAt DateTime   @default(now()) @map("created_at")
  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

enum Sex {
  MALE
  FEMALE
}

model Child {
  id              String           @id @default(uuid()) @db.Uuid
  familyId        String           @map("family_id") @db.Uuid
  name            String
  birthDate       DateTime         @map("birth_date") @db.Date
  sex             Sex?
  /// アレルギー・避けたい食材（食事の提案で必ず除外する）
  avoidFoods      String?          @map("avoid_foods")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  records         Record[]
  mealSuggestions MealSuggestion[]
  weeklyReports   WeeklyReport[]

  @@index([familyId])
  @@map("children")
}

enum RecordType {
  MILK
  SLEEP
  WEIGHT
  MEAL
}

enum MealAmount {
  ALL
  HALF
  LITTLE
  NONE
}

enum MealReaction {
  LIKED
  NEUTRAL
  DISLIKED
}

model Record {
  id           String        @id @default(uuid()) @db.Uuid
  childId      String        @map("child_id") @db.Uuid
  createdById  String?       @map("created_by_id") @db.Uuid
  type         RecordType
  startedAt    DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?     @map("ended_at") @db.Timestamptz(3)
  amountMl     Int?          @map("amount_ml")
  weightG      Int?          @map("weight_g")
  note         String?
  /// 食事のみ（任意）
  mealAmount   MealAmount?   @map("meal_amount")
  mealReaction MealReaction? @map("meal_reaction")
  createdAt    DateTime      @default(now()) @map("created_at")
  child        Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([childId, startedAt])
  @@index([childId, type, startedAt])
  @@map("records")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// メールでの家族招待。コードは平文を保存せずハッシュのみ持つ
model FamilyInvite {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  /// 招待先（小文字化済み）。このアドレスでログインしている人だけが参加できる
  email       String
  codeHash    String    @unique @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  usedById    String?   @map("used_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([createdById, createdAt])
  @@map("family_invites")
}

enum MealSuggestionStatus {
  PENDING
  READY
  FAILED
}

/// Claude による次の食事の提案（こどもごとに履歴を残し、最新を表示する）。
/// Claude を呼ぶ前に PENDING で作って回数枠を確保し、失敗も回数に数える（失敗しても課金されうるため）
model MealSuggestion {
  id          String               @id @default(uuid()) @db.Uuid
  childId     String               @map("child_id") @db.Uuid
  createdById String?              @map("created_by_id") @db.Uuid
  status      MealSuggestionStatus @default(PENDING)
  /// 構造化出力（サーバーで検証済みの JSON）。READY のときだけ入る
  content     Json?
  model       String
  createdAt   DateTime             @default(now()) @map("created_at")
  child       Child                @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@index([createdById, createdAt])
  // サービス全体の 1 日の件数（ロック中に数える）を速くする
  @@index([createdAt])
  @@map("meal_suggestions")
}

enum WeeklyReportStatus {
  PENDING
  READY
  FAILED
}

/// 週次の習慣レポート。Batches API で非同期に作る
model WeeklyReport {
  id          String             @id @default(uuid()) @db.Uuid
  childId     String             @map("child_id") @db.Uuid
  /// 対象期間（前週金曜 17:00〜今週金曜 17:00 JST）
  periodStart DateTime           @map("period_start") @db.Timestamptz(3)
  periodEnd   DateTime           @map("period_end") @db.Timestamptz(3)
  status      WeeklyReportStatus @default(PENDING)
  content     Json?
  model       String
  batchId     String?            @map("batch_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  readyAt     DateTime?          @map("ready_at")
  /// 完成メールを送った時刻（送り漏れを Cron で再送するため）
  notifiedAt  DateTime?          @map("notified_at")
  child       Child              @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, periodEnd])
  @@index([status, batchId])
  @@map("weekly_reports")
}

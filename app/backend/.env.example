# ---- ローカル（docker compose の値と一致）----
# 検証/本番では Vercel の環境変数に設定する。値はリポジトリに置かない。
NODE_ENV=development
PORT=3000

# アプリが使う接続（Supabase では transaction pooler :6543）
DATABASE_URL=postgresql://cradle:cradle@localhost:5432/cradle
# マイグレーション用の直接接続（Supabase では :5432 の session/direct 接続）
DIRECT_URL=postgresql://cradle:cradle@localhost:5432/cradle

# 32文字以上のランダム文字列（本番は `openssl rand -base64 48` などで生成）
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# カンマ区切り。モバイルアプリのみなら空でよい
CORS_ORIGINS=

# DB 接続プールの上限（省略時: Vercel 上は 2、それ以外は 10）
# DB_POOL_MAX=10

# ---- メール（家族招待）----
# 送信手段・差出人・APP_URL の 3 つがそろったときだけ招待メールを送れる（未設定なら招待の送信は 503）
# 本番（Vercel）: RESEND_API_KEY=re_... を設定すると Resend の API（公式 SDK）で送る
# ローカル:       RESEND_API_KEY は設定せず、SMTP_URL で docker compose の Mailpit に送る
#                 （外部には届かない。http://localhost:8025 で確認）
# RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=すくすく記録 <no-reply@cradle.local>
# 招待リンクの起点（Web の URL）。本番は https://<domain>
APP_URL=http://localhost:8080

# ---- AI（食事の提案・習慣レポート）----
# 選んだプロバイダの API キーがあるときだけ有効（未設定なら AI 機能は 503）。切り替えは環境変数だけで行う
# LLM_PROVIDER=google          # google（既定）/ openai / anthropic
# LLM_MODEL=gemini-3.7-flash   # 省略時: google=gemini-3.7-flash / openai=gpt-5.4-mini / anthropic=claude-sonnet-5
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 習慣レポートの定期実行（Vercel Cron）の認証。32 文字以上。未設定なら Cron のエンドポイントは無効
# CRON_SECRET=

# ---- ローカル（docker compose の値と一致）----
# 検証/本番では Vercel の環境変数に設定する。値はリポジトリに置かない。
NODE_ENV=development
PORT=3000

# アプリが使う接続（Supabase では transaction pooler :6543）
DATABASE_URL=postgresql://cradle:cradle@localhost:5432/cradle
# マイグレーション用の直接接続（Supabase では :5432 の session/direct 接続）
DIRECT_URL=postgresql://cradle:cradle@localhost:5432/cradle

# 32文字以上のランダム文字列（本番は `openssl rand -base64 48` などで生成）
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# カンマ区切り。モバイルアプリのみなら空でよい
CORS_ORIGINS=

# DB 接続プールの上限（省略時: Vercel 上は 2、それ以外は 10）
# DB_POOL_MAX=10

# ---- メール（家族招待）----
# 3 つとも設定したときだけ招待メールを送れる（未設定なら招待 API は 503）
# ローカル: docker compose の Mailpit（外部には届かない。http://localhost:8025 で確認）
# 本番:     SMTP_URL=smtps://resend:<Resend の API キー>@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=すくすく記録 <no-reply@cradle.local>
# 招待リンクの起点（Web の URL）。本番は https://<domain>
APP_URL=http://localhost:8080

# ---- Claude API（食事の提案・週次レポート）----
# 未設定なら提案 API は 503、週次レポートは作らない（ローカルで試すときだけ設定。実際に課金される）
# ANTHROPIC_API_KEY=
# 省略時: claude-sonnet-5
# CLAUDE_MODEL=claude-sonnet-5
# Vercel Cron の認証用（32 文字以上。`openssl rand -hex 32` などで生成）。ローカルで Cron を試すときは任意の値
# CRON_SECRET=
